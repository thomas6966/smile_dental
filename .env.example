# ================== ASOSIY ==================
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# ============ MA'LUMOTLAR BAZASI (Neon) ============
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&connection_limit=8&pool_timeout=60"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ================ TELEGRAM BOT ================
BOT_TOKEN=

# ============ MINI APP MANZILI (https) ============
# auto — NGROK_AUTHTOKEN bo'lsa ngrok, bo'lmasa Cloudflare Tunnel (akkaunt shart emas)
TUNNEL=auto
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
WEBAPP_URL=

# ================ ADMIN PANEL ================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=

# ================ KLINIKA ================
TIMEZONE_OFFSET=5

# ================ TEST REJIMI ================
DEV_AUTH=true
