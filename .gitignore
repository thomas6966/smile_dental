# ==========================================================
#  Stomatologiya klinikasi — Git'ga qo'shilmaydigan fayllar
# ==========================================================

# --- Maxfiy sozlamalar: bot tokeni, baza paroli, ngrok tokeni ---
.env
.env.*
!.env.example
render.env

# --- O'rnatilgan paketlar (npm install qayta o'rnatadi) ---
node_modules/

# --- Yig'ilgan fayllar (npm run build qayta yaratadi) ---
dist/
dist-ssr/
dist-vercel/
.vite/
*.local

# --- Vercel CLI sozlamalari ---
.vercel/

# --- Admin Paneldan yuklangan rasmlar ---
uploads/

# --- Cloudflare Tunnel dasturi (setup.bat qayta yuklab oladi) ---
bin/

# --- Loglar ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Vaqtinchalik fayllar ---
coverage/
.cache/
*.tmp
*.temp

# --- Kod muharrirlari sozlamalari ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.sw?

# --- Windows va macOS tizim fayllari ---
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

